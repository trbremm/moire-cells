     "t": 300,
     "js": "const v = moire.control.view(), s = moire.light.params.mode === 'spot' ? moire.light.spot() : null; const pts = []; for (let k = 0; k < 20; k++) { const a = 2 * Math.PI * k / 20 + 0.3; if (s) { const r = s.r * (0.2 + 0.6 * ((k * 7) % 10) / 10); pts.push([s.x + r * Math.cos(a), s.y + r * Math.sin(a)]); } else pts.push([v.cssW * (0.1 + 0.8 * ((k * 0.618034) % 1)), v.cssH * (0.1 + 0.8 * ((k * 0.381966 + 0.2) % 1))]); } return await moire.predators.place(pts)"
    },
    {
     "t": 359.9,
     "js": "return JSON.stringify(await moire.predators.focus('wrap', 6))"
    },
    {
     "t": 361.9,
     "js": "return JSON.stringify(await moire.predators.focus('digest', 6))"
    },
    {
