{
 "batch": "n2-look",
 "runs": [
  {
   "name": "n2-look-currents_s3",
   "description": "the currents world",
   "query": {
    "terrain": "currents",
    "seed": 3
   },
   "duration": 602,
   "sample_every": 30,
   "stall": 300,
   "shots": [
    {
     "t": 120,
     "name": "t120"
    },
    {
     "t": 300,
     "name": "t300"
    },
    {
     "t": 600,
     "name": "t600"
    },
    {
     "t": 600,
     "view": "machinery",
     "name": "t600-mach"
    },
    {
     "t": 600,
     "crop": [
      400,
      250,
      480,
      300
     ],
     "scale": 2.5,
     "name": "t600-zoom"
    }
   ],
   "evals": [
    {
     "t": 600,
     "js": "return JSON.stringify({flow: moire.flow.census, diag: await moire.flow.diagnose()})"
    }
   ]
  },
