{
 "batch": "c12f-thr2",
 "runs": [
  {
   "name": "c12f-thr-nomembrane",
   "description": "C12f: throttle test (nomembrane), 10 min",
   "query": {
    "preset": "vent",
    "seed": 3,
    "starter": 1,
    "searate": 0.02,
    "sealevel": 0.5,
    "ventheat": 10,
    "membrane": 0
   },
   "evals": [
    {
     "t": 0,
     "js": "moire.matter.springs.filter(s => s.kind === 'heavy').forEach(s => s.rate = 40); return moire.matter.springs.map(s => s.kind + ' ' + s.rate)"
    }
   ],
   "duration": 600,
   "sample_every": 10,
   "snapshots": [
    {
     "t": 150,
     "grid": true
    },
    {
     "t": 600,
     "grid": true
    }
   ],
   "shots": [
    {
     "t": 600
    }
   ]
  },
  {
   "name": "c12f-thr-nomembrane-nocof",
   "description": "C12f: throttle test (nomembrane-nocof), 10 min",
   "query": {
    "preset": "vent",
    "seed": 3,
    "starter": 1,
    "searate": 0.02,
    "sealevel": 0.5,
    "ventheat": 10,
    "membrane": 0,
    "cofactor": 0
   },
   "evals": [
    {
     "t": 0,
     "js": "moire.matter.springs.filter(s => s.kind === 'heavy').forEach(s => s.rate = 40); return moire.matter.springs.map(s => s.kind + ' ' + s.rate)"
    }
   ],
   "duration": 600,
   "sample_every": 10,
   "snapshots": [
    {
     "t": 150,
     "grid": true
    },
    {
     "t": 600,
     "grid": true
    }
   ],
   "shots": [
    {
     "t": 600
    }
   ]
  }
 ]
}