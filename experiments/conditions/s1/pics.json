{
 "batch": "s1-pics",
 "seeds": [
  3
 ],
 "runs": [
  {
   "name": "s1-pics-default",
   "description": "step S1 pictures: default, at 300 s: neon, a close zoom (neon, harmonic), harmonic",
   "query": {
    "founders": "wild",
    "wild": "shape"
   },
   "duration": 310,
   "sample_every": 60,
   "stall": 300,
   "snapshots": [],
   "dpr": 2,
   "shots": [
    {
     "t": 300,
     "name": "dish_neon"
    },
    {
     "t": 304,
     "name": "zoom_neon"
    },
    {
     "t": 306,
     "name": "zoom_harm"
    },
    {
     "t": 308,
     "name": "dish_harm"
    }
   ],
   "evals": [
    {
     "t": 299,
     "js": "return JSON.stringify(moire.spindle.census)"
    },
    {
     "t": 303,
     "js": "moire.camera.set(3.5, 0.45 * moire.dish.W, 0.45 * moire.dish.H); return 'zoom'"
    },
    {
     "t": 305,
     "js": "moire.control.action('harmonic'); return 'harmonic toggled'"
    },
    {
     "t": 307,
     "js": "moire.camera.fit(); return 'fit'"
    }
   ]
  },
